# Paquetes generados: estudiar desde la carpeta o reconstruir con herramientas/empaquetar.py.
*.zip
paquetes/*.zip

# Índices, sesiones del navegador y cachés de Python.
.codegraph/
.cursor/
.playwright-cli/
__pycache__/
**/__pycache__/
*.py[cod]

# Scripts e imágenes intermedias de autoría (no forman parte de los datos canónicos).
herramientas/autoria/estudio/
herramientas/autoria/bancos/
herramientas/autoria/ajustar_*.py
herramientas/autoria/generar_anexos.py
herramientas/autoria/revisar_paginas.py
herramientas/autoria/versionar_recursos.py
biblioteca/2026/referencias/juvenil-paginas/

# Conservar sólo las comprobaciones reproducibles y los informes finales en validaciones/.
validaciones/capturas-previas/
validaciones/playwright/*
!validaciones/playwright/comprobar-portal.js
!validaciones/playwright/comprobar-final.js
!validaciones/playwright/comprobar-navegacion.js
!validaciones/playwright/comprobar-taller.js
!validaciones/playwright/comprobar-taller-video.js
!validaciones/playwright/comprobar-rotacion.js
!validaciones/playwright/comprobar-mapas.js

# Cachés de render; las fuentes de video y MP4 terminados sí se versionan.
herramientas/video-estudio/.hyperframes/
herramientas/video-estudio/.thumbnails/
herramientas/video-estudio/snapshots/

.vercel
